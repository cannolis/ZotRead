{
  "name": "zotread",
  "type": "module",
  "version": "0.1.9",
  "description": "ZotRead — Triage your Zotero reading queue. Decide which paper to read next, not just collect more.",
  "config": {
    "addonName": "ZotRead",
    "addonID": "zotread@zotero.org",
    "addonRef": "zotread",
    "addonInstance": "ZotRead",
    "prefsPrefix": "extensions.zotero.zotread"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cannolis/zotread.git"
  },
  "author": "Carlos <lichenglong.me@outlook.com>",
  "bugs": {
    "url": "https://github.com/cannolis/zotread/issues"
  },
  "homepage": "https://github.com/cannolis/zotread#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.6",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.7",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
